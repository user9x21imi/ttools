  "prerequisites": [
    "Linux x86_64; this local runtime tested with glibc 2.43",
    "Python 3.9+ only for installer; application includes Python and dependencies",
    "UTF-8 terminal, recommended minimum 78x24; standard monospace font, no Nerd Font required",
    "Working ALSA/PipeWire/PulseAudio audio output for playback",
    "Spotify Premium, Internet and OAuth needed for music; not for install or demo"
  ],
  "install_argv": [
    "python3",
    "${BUNDLE}/install.py",
    "--prefix",
    "${PREFIX}",
    "--manifest",
    "${BUNDLE}/update.json",
    "--archive",
    "${BUNDLE}/runtime/tspotify-linux-x86_64.zip"
  ],
  "launch_argv": [
    "${PREFIX}/bin/tspotify"
  ],
  "version_argv": [
    "${PREFIX}/bin/tspotify",
    "--version"
  ],
  "update_manifest_url": null,
  "update_manifest_local": "${BUNDLE}/update.json",
  "update_owner": "ttools",
  "stop": {
    "argv": [
      "${PREFIX}/bin/tspotify",
      "stop",
      "--timeout",
      "15"
    ],
    "status_argv": [
      "${PREFIX}/bin/tspotify",
      "status"
    ],
    "success": "exit 0 and JSON stopped=true after UI and owned engine exit; running=false means already stopped",
    "on_timeout": "do not update; wait for shutdown or report failure"
  },
  "data_paths": [
    "${HOME}/.config/tspotify",
    "${HOME}/.local/share/tspotify",
    "${HOME}/.cache/tspotify",
    "${HOME}/.cache/spotify-player (legacy OAuth/engine cache if already present)"
